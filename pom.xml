<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>org.project</groupId>
    <artifactId>LOS-LITE</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>LOS-LITE</name>
    <description>Mini Loan Origination System</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <blaze-persistence.version>1.6.15</blaze-persistence.version>
        <!-- 5.1.0 = versi terakhir dari groupId ASLI com.querydsl (project ini sudah tidak
             dikembangkan lagi, tidak pernah rilis versi patch - fix CVE-2024-49203 di bawah
             cuma ada di fork komunitas io.github.openfeign.querydsl, TAPI kita sengaja tetap
             di groupId asli ini, lihat alasan di komentar dependency querydsl-core). -->
        <querydsl.version>5.1.0</querydsl.version>
    </properties>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Security (untuk JWT nanti) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- WebClient: panggil HTTP ke service eksternal (Python OCR). Kita pakai
             SECARA BLOCKING (.block()), bukan reactive penuh - cukup ambil WebClient-nya
             saja tanpa perlu netty server reaktif, supaya tidak overengineering. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- .env loader: baca file .env di root project ke Spring Environment -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- Database driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Blaze-Persistence: query builder di atas JPA Criteria (dipakai lewat
             CriteriaBuilderFactory, lihat QueryConfig). Integration artifact
             "hibernate-6.2" resmi meng-cover semua Hibernate 6.2+ (termasuk 6.6.x
             yang dibawa Spring Boot 3.5.14 ini), jadi TIDAK ada artifact
             "hibernate-6.6" terpisah - ini bukan salah pilih versi. -->
        <dependency>
            <groupId>com.blazebit</groupId>
            <artifactId>blaze-persistence-core-api-jakarta</artifactId>
            <version>${blaze-persistence.version}</version>
        </dependency>
        <dependency>
            <groupId>com.blazebit</groupId>
            <artifactId>blaze-persistence-core-impl-jakarta</artifactId>
            <version>${blaze-persistence.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.blazebit</groupId>
            <artifactId>blaze-persistence-integration-hibernate-6.2</artifactId>
            <version>${blaze-persistence.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Blaze-Persistence Entity View: modul TERPISAH dari CriteriaBuilder biasa di atas -
             DTO projection dideklarasikan lewat interface ber-anotasi @EntityView (lihat
             RefCodeView), implementasi Impl-nya di-generate annotation processor
             (blaze-persistence-entity-view-processor-jakarta) mirip Lombok, lalu di-"apply"
             ke query CriteriaBuilder lewat bean EntityViewManager (lihat QueryConfig &
             RefCodeRepositoryImpl). -->
        <dependency>
            <groupId>com.blazebit</groupId>
            <artifactId>blaze-persistence-entity-view-api-jakarta</artifactId>
            <version>${blaze-persistence.version}</version>
        </dependency>
        <dependency>
            <groupId>com.blazebit</groupId>
            <artifactId>blaze-persistence-entity-view-impl-jakarta</artifactId>
            <version>${blaze-persistence.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- QueryDSL - DIPAKAI ULANG, tapi SEMPIT: cuma sebagai generator Q-class (mis. QRefCode)
             buat type-safety nama field entity di compile-time, BUKAN sebagai query engine.
             Mesin eksekusi query tetap 100% Blaze-Persistence CriteriaBuilder (lihat
             RefCodeRepositoryImpl) - Q-class cuma dipakai buat ambil nama property lewat
             `.getMetadata().getName()`, hasilnya string biasa yang disuntik ke
             `CriteriaBuilder.where(...)`. Makanya di sini SENGAJA cuma ada querydsl-core
             (base type Q-class seperti EntityPathBase/StringPath) - TIDAK ada querydsl-jpa
             ataupun querydsl-sql (mesin JPAQuery/SQLQuery beneran, sumber CVE-2024-49203 lewat
             JPAQuery.orderBy - lihat komentar di properties). Karena JPAQuery tidak pernah
             dipanggil sama sekali, jalur vulnerable-nya memang tidak pernah tersentuh, meskipun
             groupId ini (com.querydsl, BUKAN fork io.github.openfeign.querydsl) sengaja dipin
             ke versi yang belum ada patch resminya. querydsl-core sendiri persistence-API
             agnostic (cuma base Path type), jadi tidak butuh classifier "jakarta" (beda dari
             querydsl-apt di annotationProcessorPaths bawah, yang butuh). -->
        <dependency>
            <groupId>com.querydsl</groupId>
            <artifactId>querydsl-core</artifactId>
            <version>${querydsl.version}</version>
        </dependency>

        <!-- Lombok: hilangkan boilerplate getter/setter/constructor di entity -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JWT: generate & validasi access token -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 2.6.0 lama tidak kompatibel dgn Spring Framework yg dibawa Boot 3.5.x
             (NoSuchMethodError di ControllerAdviceBean).
             CATATAN: springdoc versi 3.x (yang sempat saya coba) ternyata untuk Spring Boot 4.x
             (paket "org.springframework.boot.webmvc.autoconfigure.*" yang baru), BUKAN Boot 3.5.x
             -> menyebabkan duplicate bean 'conventionErrorViewResolver' saat startup.
             Yang benar untuk Boot 3.5.x tetap di jalur 2.x -> 2.8.5. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.5</version>
        </dependency>

        <!-- Override transitive commons-lang3 (dibawa springdoc) -> versi 3.17.0 kena
             CVE-2025-48924 (DoS via StackOverflowError di ClassUtils.getClass()).
             Deklarasi eksplisit di sini menang atas transitive dependency (Maven "nearest wins"). -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- annotationProcessorPaths dideklarasikan MANUAL di sini karena
                 blaze-persistence-entity-view-processor-jakarta butuh diaktifkan sebagai
                 annotation processor (generate Impl class dari interface @EntityView, lihat
                 RefCodeView & QueryConfig). CATATAN PENTING: begitu salah satu processor path
                 dikonfigurasi manual, Maven berhenti auto-detect processor dari classpath -
                 Lombok WAJIB ikut dicantumkan di sini juga, kalau tidak getter/setter/builder
                 di semua entity berhenti ter-generate.

                 CATATAN #2: classpath annotationProcessorPaths itu TERISOLASI dari classpath
                 compile biasa - bukan cuma daftar tambahan, tapi classpath processor sendiri
                 dari nol. Processor Entity View butuh baca class jakarta.persistence.Entity
                 buat scan @Entity yang dirujuk tiap @EntityView, tapi jakarta.persistence-api
                 (biasanya numpang lewat spring-boot-starter-data-jpa) TIDAK otomatis ikut ke
                 classpath ini - makanya jakarta.persistence-api WAJIB didaftarkan eksplisit
                 juga di sini, kalau tidak processor-nya crash NoClassDefFoundError dan
                 seluruh round annotation processing gagal (Lombok punya ikut nggak jalan). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>com.blazebit</groupId>
                            <artifactId>blaze-persistence-entity-view-processor-jakarta</artifactId>
                            <version>${blaze-persistence.version}</version>
                        </path>
                        <!-- Generate Q-class (mis. QRefCode) dari entity ber-anotasi @Entity -
                             classifier "jakarta" WAJIB dipilih (bukan default/"jpa") karena
                             project ini pakai jakarta.persistence.*, bukan javax.persistence.*.
                             Hasil generate-nya masuk target/generated-sources/annotations, satu
                             paket dengan entity aslinya (lihat catatan di querydsl-core, pom
                             ini). Lupa daftarin di sini -> Q-class tidak ke-generate sama
                             sekali, RefCodeRepositoryImpl gagal compile "cannot find symbol
                             QRefCode". -->
                        <path>
                            <groupId>com.querydsl</groupId>
                            <artifactId>querydsl-apt</artifactId>
                            <version>${querydsl.version}</version>
                            <classifier>jakarta</classifier>
                        </path>
                        <path>
                            <groupId>jakarta.persistence</groupId>
                            <artifactId>jakarta.persistence-api</artifactId>
                            <version>${jakarta-persistence.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- Sengaja TIDAK diisi <annotationProcessors> - dengan dibiarkan kosong,
                         Maven compiler plugin otomatis pakai SEMUA processor yang terdaftar di
                         META-INF/services milik tiap jar di annotationProcessorPaths di atas
                         (Lombok & entity-view-processor keduanya sudah daftar processor-nya
                         sendiri). Hardcode nama class processor di sini rawan salah/berubah
                         antar versi. -->
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

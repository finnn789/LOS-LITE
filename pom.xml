<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>org.project</groupId>
    <artifactId>LOS-LITE</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>LOS-LITE</name>
    <description>Mini Loan Origination System</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <blaze-persistence.version>1.6.15</blaze-persistence.version>
    </properties>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Security (untuk JWT nanti) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- WebClient: panggil HTTP ke service eksternal (Python OCR). Kita pakai
             SECARA BLOCKING (.block()), bukan reactive penuh - cukup ambil WebClient-nya
             saja tanpa perlu netty server reaktif, supaya tidak overengineering. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- .env loader: baca file .env di root project ke Spring Environment -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- Database driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Blaze-Persistence: query builder di atas JPA Criteria (dipakai lewat
             CriteriaBuilderFactory, lihat QueryConfig). Integration artifact
             "hibernate-6.2" resmi meng-cover semua Hibernate 6.2+ (termasuk 6.6.x
             yang dibawa Spring Boot 3.5.14 ini), jadi TIDAK ada artifact
             "hibernate-6.6" terpisah - ini bukan salah pilih versi. -->
        <dependency>
            <groupId>com.blazebit</groupId>
            <artifactId>blaze-persistence-core-api-jakarta</artifactId>
            <version>${blaze-persistence.version}</version>
        </dependency>
        <dependency>
            <groupId>com.blazebit</groupId>
            <artifactId>blaze-persistence-core-impl-jakarta</artifactId>
            <version>${blaze-persistence.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.blazebit</groupId>
            <artifactId>blaze-persistence-integration-hibernate-6.2</artifactId>
            <version>${blaze-persistence.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok: hilangkan boilerplate getter/setter/constructor di entity -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JWT: generate & validasi access token -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Camunda 8 (Zeebe) client - untuk trigger & subscribe proses BPMN yang jalan
             di broker Zeebe TERPISAH (Camunda 8 Run lokal, lihat README/catatan setup).
             Versi 8.8.6 dipilih SENGAJA (bukan versi terbaru io.camunda:camunda-spring-boot-3-starter
             yang baru ada rilis 8.10.0-alpha - masih alpha, belum stabil untuk dipakai):
             8.8.6 terverifikasi target Spring Boot 3.5.6, cocok dgn parent project ini (3.5.14).
             Broker lokal (C8Run) yang dipakai versi 8.10.0-alpha3 - ada gap versi client vs
             broker, tapi protokol gRPC Zeebe umumnya backward-compatible; kalau nanti ada error
             handshake/versi saat connect, ini kandidat pertama yang perlu dicek. -->
        <dependency>
            <groupId>io.camunda</groupId>
            <artifactId>camunda-spring-boot-starter</artifactId>
            <version>8.8.6</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 2.6.0 lama tidak kompatibel dgn Spring Framework yg dibawa Boot 3.5.x
             (NoSuchMethodError di ControllerAdviceBean).
             CATATAN: springdoc versi 3.x (yang sempat saya coba) ternyata untuk Spring Boot 4.x
             (paket "org.springframework.boot.webmvc.autoconfigure.*" yang baru), BUKAN Boot 3.5.x
             -> menyebabkan duplicate bean 'conventionErrorViewResolver' saat startup.
             Yang benar untuk Boot 3.5.x tetap di jalur 2.x -> 2.8.5. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.5</version>
        </dependency>

        <!-- Override transitive commons-lang3 (dibawa springdoc) -> versi 3.17.0 kena
             CVE-2025-48924 (DoS via StackOverflowError di ClassUtils.getClass()).
             Deklarasi eksplisit di sini menang atas transitive dependency (Maven "nearest wins"). -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
